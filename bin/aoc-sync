#!/usr/bin/env bash
# Rebuild Aoc.lean from the day files under Aoc/.
# Usage: bin/aoc-sync
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

imports=()
entries=()

while IFS= read -r file; do
  path="${file#Aoc/}"        # Y2015/Day01.lean
  path="${path%.lean}"       # Y2015/Day01
  ydir="${path%%/*}"         # Y2015
  dfile="${path##*/}"        # Day01
  imports+=("import Aoc.$ydir.$dfile")
  for part in 1 2; do
    entries+=("  { year := $((10#${ydir#Y})), day := $((10#${dfile#Day})), part := $part, solve := $ydir.$dfile.part$part }")
  done
done < <(find Aoc -mindepth 2 -name 'Day*.lean' | sort)

if ((${#entries[@]})); then
  list=$'[\n'"$(printf '%s,\n' "${entries[@]}" | sed '$ s/,$//')"$'\n]'
else
  list="[]"
fi

{
  echo "-- Generated by bin/aoc-sync. Do not edit."
  echo "--"
  echo "-- Every puzzle part the solve executable can run. Lean only sees a module"
  echo "-- that something imports, so putting a file under Aoc/ is not enough: this"
  echo "-- file imports each day and names its two parts."
  echo "import Aoc.Core"
  ((${#imports[@]})) && printf '%s\n' "${imports[@]}"
  echo
  echo "namespace Aoc"
  echo
  echo "def solutions : List Entry := $list"
  echo
  echo "end Aoc"
} > Aoc.lean

echo "sync:   Aoc.lean (${#entries[@]} parts)"
